# Những gì KHÔNG đưa vào build context của image frontend.
# node_modules bị loại vì giai đoạn build cài lại bằng `npm ci`.
node_modules
npm-debug.log*
yarn-error.log*

# build/ là sản phẩm của lần build trước — để CRA build lại từ source trong image.
build

# Secret và file cấu hình riêng của máy, trừ file mẫu.
.env
.env.*
!.env.example

# Không cần cho lúc build/chạy.
coverage
.DS_Store
README.md
CLAUDE.md
.prettierrc
Dockerfile
.dockerignore
.git
