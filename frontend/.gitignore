# .gitignore cục bộ của frontend — lưới an toàn nếu thư mục này được tách ra khỏi repo.
# (Ở repo đầy đủ, .gitignore gốc đã chặn các mục dưới đây.)

# phụ thuộc
/node_modules
/.pnp
.pnp.js

# sản phẩm build và coverage
/dist
/coverage

# biến môi trường — .env chứa cấu hình riêng của máy, không commit
.env
.env.*
!.env.example

# log và file của hệ điều hành
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
