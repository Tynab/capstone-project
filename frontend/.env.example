# Đích của API, CRA nhúng biến REACT_APP_* vào bundle lúc build.
# Bỏ trống thì mặc định là http://localhost:8000/api (xem src/api/client.js).
#
# Khi deploy Docker/VPS: đặt thành URL công khai của backend, hoặc dùng đường dẫn
# tương đối /api nếu web server có proxy /api sang backend. Cách dùng đường dẫn
# tương đối được khuyến nghị: không phải cấu hình CORS, và không bị chặn mixed
# content khi trang chạy https.
REACT_APP_API_URL=http://localhost:8000/api
