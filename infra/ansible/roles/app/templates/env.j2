# Sinh bởi Ansible (infra/ansible/roles/app). KHÔNG sửa tay: lần provision sau ghi đè.
# Mọi giá trị đều là chữ và số -> an toàn khi `set -a; . .env` và khi nội suy vào compose.
JWT_SECRET="{{ jwt_secret }}"
MONGO_ROOT_USERNAME="capstone"
MONGO_ROOT_PASSWORD="{{ mongo_root_password }}"
MONGO_URI="mongodb://capstone:{{ mongo_root_password }}@mongo:27017/todo?authSource=admin"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="{{ grafana_admin_password }}"
FRONTEND_URL="{{ app_url }}"
CORS_ORIGIN="{{ app_url }}"
# nginx đứng trước backend -> bắt buộc bật, nếu không rate limit đếm chung một IP.
TRUST_PROXY="1"
LOG_LEVEL="info"
# Mailpit trong stack. Đổi SMTP_HOST thành rỗng để quay lại dùng Gmail như cũ.
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Image mặc định là bản latest trên GHCR; job deploy ghi đè bằng tag sha-xxxx.
BACKEND_REPO="ghcr.io/tynab/capstone-project-backend"
FRONTEND_REPO="ghcr.io/tynab/capstone-project-frontend"
BACKEND_IMAGE="${BACKEND_REPO}:latest"
FRONTEND_IMAGE="${FRONTEND_REPO}:latest"
