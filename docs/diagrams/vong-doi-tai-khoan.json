  "cards": [
    {
      "dot": "cyan",
      "title": "Vì sao phiên chết ngay khi đổi mật khẩu",
      "items": [
        "JWT hạn 3 ngày; requireAuth đọc tokenVersion từ DB mỗi request chứ không tin mỗi chữ ký",
        "Đổi mật khẩu làm tokenVersion tăng nên mọi JWT cũ bị 401 — client xoá token khỏi cả localStorage lẫn state React",
        "401 chỉ chuyển hướng khi đang ở trang cần đăng nhập, để link reset còn mở được"
      ]
    },
    {
      "dot": "rose",
      "title": "Reset mật khẩu an toàn ở đâu",
      "items": [
        "forgotPassword: rate limit 5/giờ chống spam mail; email lạ vẫn cùng thông báo, mail gửi không await để thời gian phản hồi không lộ email",
        "resetPassword: rate limit 10/15 phút chống dò token; mật khẩu mới ≥ 8 ký tự",
        "Token thô 20 byte chỉ nằm trong mail, DB giữ SHA-256 + hạn 15 phút; findOneAndUpdate nguyên tử nên dùng được đúng một lần",
        "Trạng thái reset nằm trong DB, độc lập với phiên: đang đăng nhập vẫn yêu cầu được, và đăng nhập bằng mật khẩu cũ không xoá token reset"
      ]
    },
    {
      "dot": "violet",
      "title": "Đăng ký và đăng nhập bị chặn ở đâu",
      "items": [
        "Đăng ký: mật khẩu ≥ 8 ký tự, bcrypt cost 10, rate limit 20/giờ, email trùng trả \"User already exists\"",
        "Đăng nhập: rate limit 10/15 phút; sai email hay sai mật khẩu đều cùng thông báo"
      ]
    },
    {
      "dot": "amber",
      "title": "Trạng thái KHÔNG tồn tại trong hệ thống này",
      "items": [
        "Không có khoá tài khoản và không có xoá tài khoản — vượt rate limit chỉ là 429 tạm thời, không đổi trạng thái",
        "Vì vậy đồ thị không có trạng thái kết thúc: tài khoản luôn quay về được Đã đăng xuất"
      ]
    }
