# =============================================================================
# backend/.env.example — mẫu cấu hình cho backend.
# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env (đã bị .gitignore chặn vì chứa JWT_SECRET thật).
# Trong lab Docker Swarm, các biến này do Ansible sinh và ghi vào /opt/capstone/.env.
# =============================================================================

# --------------------------------------------------------------- bắt buộc
# Chuỗi kết nối MongoDB. Server chỉ mở cổng SAU khi kết nối được DB.
MONGO_URI=mongodb://localhost:27017/todo

# Bí mật ký JWT. Server THOÁT NGAY nếu thiếu biến này.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --------------------------------------------------------------- máy chủ
# Cổng API. (Trong mã, nếu bỏ trống thì mặc định là 8001; image Docker đặt sẵn 8000.)
PORT=8000

# Origin được phép gọi API, phân tách bằng dấu phẩy. Origin lạ bị từ chối bằng
# cách không gắn header CORS.
CORS_ORIGIN=http://localhost:3000

# Gốc của frontend, dùng để dựng link reset mật khẩu trong email.
# Thiếu biến này thì rơi về giá trị mặc định trong mã.
FRONTEND_URL=http://localhost:3000

# Đặt =1 CHỈ khi chạy sau reverse proxy (nginx/Caddy), để rate limit đọc đúng IP
# client từ X-Forwarded-For. Bật sai lúc không có proxy = cho phép client tự đặt
# header đó và vượt rate limit.
TRUST_PROXY=

# --------------------------------------------------------------- gửi mail
# Cách 1 (dùng trong lab): SMTP riêng — điền SMTP_HOST và để trống GMAIL_*.
# Trong stack Docker Swarm, Ansible đặt sẵn thành mailpit:1025 (SMTP giả của lab).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Cách 2: Gmail. GMAIL_PASSWORD phải là App Password 16 ký tự, KHÔNG phải mật
# khẩu đăng nhập. Chỉ dùng khi SMTP_HOST để trống.
GMAIL_USERNAME=
GMAIL_PASSWORD=

# --------------------------------------------------------------- log
# error | warn | info | debug (mặc định: info)
LOG_LEVEL=info
