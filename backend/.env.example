MONGO_URI=mongodb://localhost:27017/todo
GMAIL_USERNAME=
GMAIL_PASSWORD=
PORT=8000
# sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# gốc của frontend, dùng để dựng link reset trong email. Thiếu thì mặc định là bản đã deploy cũ.
FRONTEND_URL=http://localhost:3000
# đặt =1 chỉ khi chạy sau reverse proxy (nginx), để rate limit đọc đúng IP client
TRUST_PROXY=
# danh sách origin được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000,https://todo-app-b96a5.web.app

# SMTP riêng. Để TRỐNG SMTP_HOST thì giữ nguyên hành vi Gmail như cũ (dùng GMAIL_* ở trên).
# Trong lab Docker Swarm, biến này được Ansible đặt thành mailpit:1025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
